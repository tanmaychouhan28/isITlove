# Environment Variables — Copy this to server/.env and fill in your values
# DO NOT commit the actual server/.env file

# MongoDB connection string (get a free one from https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/isitlove?retryWrites=true&w=majority

# JWT secret — change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_string

# Server port (Render sets this automatically)
PORT=5000

# App environment
NODE_ENV=production
